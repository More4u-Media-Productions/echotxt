# Echo — optional environment overrides.
# Echo ships with a built-in Supabase configuration (src/config/supabase.ts),
# so the app runs with no .env file at all. Set these only to point Echo at a
# different backend; anything you set here wins over the built-in values.

VITE_SUPABASE_URL="https://uvfunsetjwdatnynwnkw.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ddsb_8-_UOfIBqFOvJ8yqQ_Bg-Mur5H"
VITE_SUPABASE_PROJECT_ID="uvfunsetjwdatnynwnkw"

# Server-side (SSR / server functions)
SUPABASE_URL="https://uvfunsetjwdatnynwnkw.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_ddsb_8-_UOfIBqFOvJ8yqQ_Bg-Mur5H"
# Never commit a real value for this one.
SUPABASE_SERVICE_ROLE_KEY=""

# Push notifications (OneSignal). The app id is public and lives in
# src/config/onesignal.ts; only the REST key is secret.
ONESIGNAL_REST_API_KEY=""
